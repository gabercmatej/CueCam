{
  "hotkey": "CommandOrControl+Shift+K",
  "defaultCooldownMs": 2000,
  "performance": { "trackEvery": 2, "adaptive": true, "trackerDelegate": "GPU" },
  "audio": { "volume": 1, "muted": false },
  "words": ["I love you", "fire", "boom", "let's go", "bye", "no way"],
  "rules": [
    { "when": { "gesture": "ThumbUp" }, "play": "thumbs_up" },
    { "when": { "gesture": "ThumbDown" }, "play": "thumbs_down" },
    { "when": { "gesture": "Victory" }, "play": "victory" },
    { "when": { "gesture": "Fist" }, "play": "confetti_hand", "perHand": true, "cooldownMs": 700 },
    { "when": { "gesture": "Rock" }, "play": ["rock_gif", "rock_sound"], "cooldownMs": 3000 },
    { "when": { "word": "I love you" }, "play": "hearts", "cooldownMs": 5000, "confirm": "final" },
    { "when": { "gesture": "Heart" }, "play": "hearts_between_hands" },
    { "when": { "gesture": "FingerGun" }, "play": "finger_gun" },
    { "when": { "gesture": "Pinch" }, "play": "light_paint", "perHand": true, "cooldownMs": 0 },
    { "when": { "gesture": "OpenPalm", "word": "fire", "withinMs": 1500 }, "play": "fire_palm", "cooldownMs": 2000 },
    { "when": { "gesture": "PointingUp" }, "play": "pointing_up" },
    { "when": { "gesture": "BothHandsUp" }, "play": "hands_up" },
    { "when": { "gesture": "Clap" }, "play": "clap", "cooldownMs": 3000 },
    { "when": { "gesture": "Pray" }, "play": "pray", "cooldownMs": 3000 },
    { "when": { "word": "boom" }, "play": ["explosion", "shake"], "cooldownMs": 4000 },
    { "when": { "word": "let's go" }, "play": "lets_go", "cooldownMs": 4000 },
    { "when": { "word": "bye" }, "play": "curtains", "cooldownMs": 6000, "confirm": "final", "minConfidence": 0.8, "pauseAfterMs": 150 }
  ],
  "effects": {
    "thumbs_up": { "type": "media", "files": "thumbs up" },
    "thumbs_down": { "type": "media", "files": "thumbs down" },
    "victory": { "type": "media", "files": "victory" },
    "confetti_hand": { "type": "particles", "preset": "confetti", "anchor": "hand", "count": 120 },
    "rock_gif": { "type": "media", "files": "rock" },
    "rock_sound": { "type": "sound", "files": "rock" },
    "hearts_between_hands": { "type": "particles", "preset": "hearts", "anchor": "between-hands", "count": 60 },
    "hearts": { "type": "media", "files": "i love you", "placement": "fullscreen", "holdMs": 4500, "fadeMs": 500, "muted": true },
    "finger_gun": { "type": "media", "files": "finger gun" },
    "light_paint": { "type": "lightPaint", "color": "rainbow", "width": 14, "fadeMs": 300 },
    "fire_palm": {
      "type": "media",
      "files": "fire",
      "placement": "anchor",
      "anchor": "hand",
      "follow": true,
      "handScale": 6,
      "crop": [0.3, 0, 0.45, 1],
      "origin": [0.5, 0.92],
      "holdMs": 1800,
      "fadeMs": 300,
      "muted": true
    },
    "pointing_up": { "type": "media", "files": "point up" },
    "hands_up": { "type": "media", "files": "hands up" },
    "clap": { "type": "media", "files": "clap", "size": 0.45 },
    "pray": { "type": "media", "files": "pray" },
    "explosion": { "type": "media", "files": "boom", "placement": "fullscreen", "layer": "back", "muted": true },
    "shake": { "type": "cameraMove", "kind": "shake", "intensity": 0.8, "durationMs": 600 },
    "lets_go": { "type": "media", "files": "lets go", "size": 0.45, "volume": 0.7 },
    "curtains": { "type": "media", "files": "bye", "placement": "fullscreen", "layer": "front" },

    "greenscreen_test": { "type": "clip", "file": "explosion_greenscreen.mp4", "key": true, "layer": "back", "anchor": "center", "scale": 0.9 },
    "grade_noway": { "type": "cameraMove", "kind": "grade", "saturation": 0, "vignette": 0.7, "durationMs": 1500, "fadeMs": 250 },
    "grade_gold": { "type": "cameraMove", "kind": "grade", "saturation": 1.1, "tint": "#ffb340", "tintAmount": 0.45, "vignette": 0.4, "durationMs": 3000, "fadeMs": 400, "gradeScope": "camera" },
    "zoom_face": { "type": "cameraMove", "kind": "zoom", "target": "face", "amount": 1.6, "durationMs": 1500 }
  }
}
